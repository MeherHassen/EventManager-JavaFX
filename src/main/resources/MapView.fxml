<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox fx:id="mapContainer" spacing="10" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17" fx:controller="controllers.MapController">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>
    
    <HBox spacing="10" alignment="CENTER">
        <Label text="Selected Location:" />
        <Label text="Lat:" />
        <TextField fx:id="latitudeField" editable="false" prefWidth="120" />
        <Label text="Long:" />
        <TextField fx:id="longitudeField" editable="false" prefWidth="120" />
    </HBox>
</VBox> 